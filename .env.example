# ============================================================
# TECH IN TOWN — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── SERVER ────────────────────────────────────────────────────
PORT=3000

# ── CLAUDE AI (Required for Max AI Technician) ───────────────
# Get your API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── ELEVENLABS VOICE (Optional — enables real-world AI voice) ─
# Get your API key at: https://elevenlabs.io/
# Without this, Max uses the browser's built-in Web Speech API
ELEVENLABS_API_KEY=
# Voice ID options:
#   pNInz6obpgDQGcFmaJgB = Adam (warm, professional male) [DEFAULT]
#   TxGEqnHWrfWFTfGW9XjX = Josh (deep, authoritative)
#   VR6AewLTigWG4xSOukaG = Arnold (strong, clear)
#   onwK4e9ZLuTAKqWW03F9 = Daniel (British, professional)
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── EMAIL — SendGrid (Recommended) ───────────────────────────
# Get your API key at: https://sendgrid.com/
# Free tier: 100 emails/day
SENDGRID_API_KEY=SG....

# ── EMAIL — SMTP Alternative (e.g. Gmail, Mailgun, SES) ──────
# Only used if SENDGRID_API_KEY is not set
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password

# ── CONTACT DESTINATION ───────────────────────────────────────
# Where booking requests and contact forms are sent
CONTACT_EMAIL=hello@techintown.com.au
